---
import { getEntityIconUrl } from '../utils/content';
import { requirementLifecycleMetadata } from '../config/requirement-lifecycle';

const entry = Astro.locals.starlightRoute.entry;
const { title, entity, icon, docType, lifecycle } = entry.data;
const iconUrl = getEntityIconUrl(entity, icon);
const lifecycleMetadata =
  docType === 'requirement' && lifecycle
    ? requirementLifecycleMetadata[lifecycle]
    : undefined;
---

<h1
  id="_top"
  data-page-title
  class:list={{ 'has-entity-icon': iconUrl }}
>
  {iconUrl && (
    <span
      class="entity-page-icon"
      style={`--entity-icon: url('${iconUrl}')`}
      aria-hidden="true"
    />
  )}
  <span class="entity-page-title__text">{title}</span>
  {lifecycleMetadata && (
    <span
      class={`requirement-lifecycle requirement-lifecycle--${lifecycle}`}
      aria-label={`Estado do requisito: ${lifecycleMetadata.label}`}
    >
      {lifecycleMetadata.label}
    </span>
  )}
</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      color: var(--sl-color-white);
      font-size: var(--sl-text-h1);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
    }

    .has-entity-icon {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35em;
      max-width: none;
      /*
       * Uma única escala fluida para toda HU. Ela preserva a hierarquia do
       * título e também acomoda os nomes de entidade mais extensos sem criar
       * exceções baseadas no conteúdo.
       */
      font-size: clamp(2rem, 4vw, 2.5rem);
    }

    .entity-page-title__text {
      min-width: 0;
    }

    .entity-page-icon {
      display: inline-block;
      flex: 0 0 auto;
      width: 0.92em;
      height: 0.92em;
      background-color: var(--sl-color-text-accent);
      mask: var(--entity-icon) center / contain no-repeat;
      -webkit-mask: var(--entity-icon) center / contain no-repeat;
    }

    .requirement-lifecycle {
      display: inline-flex;
      align-self: center;
      align-items: center;
      gap: 0.4rem;
      padding: 0.42rem 0.72rem;
      border: 1px solid color-mix(in srgb, currentColor 72%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, currentColor 16%, var(--sl-color-black));
      box-shadow: 0 3px 10px color-mix(in srgb, currentColor 14%, transparent);
      font-size: 0.76rem;
      font-weight: 750;
      line-height: 1;
      letter-spacing: 0.055em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .requirement-lifecycle::before {
      content: '';
      width: 0.42rem;
      height: 0.42rem;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 16%, transparent);
    }

    .requirement-lifecycle--draft {
      color: var(--sl-color-orange);
    }

    .requirement-lifecycle--ready {
      color: var(--sl-color-blue);
    }

    .requirement-lifecycle--published {
      color: var(--sl-color-green);
    }

    @media (min-width: 72rem) {
      .has-entity-icon {
        font-size: clamp(2rem, 2.65vw, 2.25rem);
      }
    }
  }
</style>
