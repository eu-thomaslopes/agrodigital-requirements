<version-history>
  <button class="history-trigger" type="button" aria-haspopup="dialog" hidden>
    Histórico de versões
  </button>
  <dialog aria-labelledby="version-history-title">
    <header class="history-header">
      <h2 id="version-history-title">Histórico de versões</h2>
      <form method="dialog">
        <button class="history-close" aria-label="Fechar histórico de versões">×</button>
      </form>
    </header>
    <ol class="history-timeline"></ol>
  </dialog>
</version-history>

<script>
  class VersionHistory extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const initialize = () => {
        const trigger = this.querySelector<HTMLButtonElement>('.history-trigger');
        const dialog = this.querySelector<HTMLDialogElement>('dialog');
        const timeline = this.querySelector<HTMLOListElement>('.history-timeline');
        if (!trigger || !dialog || !timeline) return;

        const normalize = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
        const heading = Array.from(document.querySelectorAll('.sl-markdown-content h2')).find(
          (element) => /^historico (da fonte|das fontes|de versoes)/.test(normalize(element.textContent ?? '')),
        );
        if (!heading) return;
        let sibling = (heading.closest('.sl-heading-wrapper') ?? heading).nextElementSibling;
        let table: HTMLTableElement | null = null;
        while (sibling && !sibling.matches('h2, .level-h2')) {
          table = sibling instanceof HTMLTableElement ? sibling : sibling.querySelector('table');
          if (table) break;
          sibling = sibling.nextElementSibling;
        }
        if (!table) return;
        const headers = Array.from(table.tHead?.rows[0]?.cells ?? [], (cell) => normalize(cell.textContent ?? ''));
        const indexes = ['versao', 'data', 'alteracao'].map((name) => headers.indexOf(name));
        if (indexes.some((index) => index < 0)) return;

        // The rendered document remains the single source, including formatted changes.
        timeline.replaceChildren();
        for (const row of Array.from(table.tBodies[0]?.rows ?? [])) {
          const [versionCell, dateCell, changeCell] = indexes.map((index) => row.cells[index]);
          if (!versionCell || !dateCell || !changeCell) continue;
          const item = document.createElement('li');
          const card = document.createElement('article');
          const meta = document.createElement('div');
          const version = document.createElement('strong');
          const date = document.createElement('span');
          const change = document.createElement('div');
          meta.className = 'history-meta';
          change.className = 'history-change';
          version.textContent = versionCell.textContent;
          date.textContent = dateCell.textContent;
          for (const node of changeCell.childNodes) change.append(node.cloneNode(true));
          meta.append(version, date);
          card.append(meta, change);
          item.append(card);
          timeline.append(item);
        }
        if (!timeline.children.length) return;
        trigger.hidden = false;
        trigger.addEventListener('click', () => dialog.showModal());
        dialog.addEventListener('click', (event) => {
          if (event.target !== dialog) return;
          const rect = dialog.getBoundingClientRect();
          if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
        });
      };
      // The title is rendered before Markdown; wait until all document tables exist.
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, { once: true });
      else initialize();
    }
  }
  if (!customElements.get('version-history')) customElements.define('version-history', VersionHistory);
</script>

<style>
  version-history { display: block; margin-top: 1rem; }
  button { font: inherit; cursor: pointer; }
  .history-trigger {
    min-height: 2.75rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--ima-radius-xs);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .history-trigger:hover { border-color: var(--sl-color-accent); }
  dialog {
    position: fixed;
    inset: 0 0 0 auto;
    margin: 0;
    padding: 0;
    width: min(28rem, 100%);
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    border: 0;
    border-inline-start: 1px solid var(--sl-color-hairline-light);
    background: var(--sl-color-black);
    color: var(--sl-color-text);
    overflow: hidden;
  }
  dialog[open] { display: flex; flex-direction: column; }
  dialog::backdrop { background: rgb(0 0 0 / 45%); }
  :global(body:has(version-history dialog[open])) { overflow: hidden; }
  .history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    flex: none;
  }
  .history-header h2 { margin: 0; font-size: 1.125rem; color: var(--sl-color-white); }
  .history-header form { margin: 0; }
  .history-close {
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--ima-radius-xs);
    background: transparent;
    color: var(--sl-color-text);
    font-size: 1.75rem;
  }
  .history-close:hover { background: var(--sl-color-accent-low); }
  .history-timeline {
    list-style: none;
    margin: 0;
    padding: 1.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    min-height: 0;
  }
  .history-timeline :global(li) {
    position: relative;
    padding: 0 0 1rem 1.25rem;
    border-inline-start: 2px solid var(--sl-color-hairline-light);
  }
  .history-timeline :global(li::before) {
    content: '';
    position: absolute;
    left: -0.4rem;
    top: 1rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 3px var(--sl-color-black);
  }
  .history-timeline :global(article) {
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--ima-radius-sm);
    overflow-wrap: anywhere;
  }
  .history-timeline :global(li:first-child article) { border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
  .history-timeline :global(.history-meta) { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; justify-content: space-between; align-items: baseline; }
  .history-timeline :global(strong) { color: var(--sl-color-white); }
  .history-timeline :global(.history-meta > span) { font-size: 0.8rem; color: var(--sl-color-gray-3); }
  .history-timeline :global(.history-change) { margin-top: 0.75rem; font-size: 0.9rem; line-height: 1.6; }
  @media print { version-history { display: none; } }
</style>
