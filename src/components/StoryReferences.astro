---
import { getCollection } from 'astro:content';
import { getDocHref } from '../utils/content';
import { createStoryReferenceIndex } from '../utils/story-references';

const entries = await getCollection('docs');
const index = createStoryReferenceIndex(entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  href: getDocHref(entry.id),
  usID: entry.data.usID,
})));
---

<span hidden data-story-reference-index={JSON.stringify(index)}></span>

<script>
  import { findStoryReferences, type StoryReferenceIndex } from '../utils/story-references';

  // Também processa as validações geradas pelos componentes compartilhados.
  function linkStoryReferences() {
    const metadata = document.querySelector<HTMLElement>('[data-story-reference-index]');
    const content = metadata?.closest('.sl-markdown-content');
    if (!metadata || !content) return;
    const index: StoryReferenceIndex = JSON.parse(metadata.dataset.storyReferenceIndex ?? '{}');
    const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);

    for (const node of nodes) {
      const parent = node.parentElement;
      if (!parent || parent.closest('a, code, pre, script, style, h1, h2, h3, h4, h5, h6')) continue;
      // Identificadores de versões são dados históricos, não referências de navegação.
      const cell = parent.closest('td');
      const table = cell?.closest('table');
      const headers = Array.from(table?.tHead?.rows[0]?.cells ?? [], (header) =>
        (header.textContent ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase(),
      );
      if (cell && headers.includes('versao') && /^(historia|versao|data)$/.test(headers[cell.cellIndex] ?? '')) continue;

      const text = node.textContent ?? '';
      const references = findStoryReferences(text, index);
      if (!references.length) continue;
      const fragment = document.createDocumentFragment();
      let cursor = 0;
      for (const reference of references) {
        fragment.append(text.slice(cursor, reference.start));
        const link = document.createElement('a');
        link.href = reference.href;
        link.textContent = reference.title;
        link.title = `${reference.code} — ${reference.title}`;
        link.dataset.storyCode = reference.code;
        fragment.append(link);
        cursor = reference.start + reference.code.length;
      }
      fragment.append(text.slice(cursor));
      node.replaceWith(fragment);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', linkStoryReferences, { once: true });
  } else {
    linkStoryReferences();
  }
  document.addEventListener('astro:page-load', linkStoryReferences);
</script>
