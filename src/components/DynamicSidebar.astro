---
import { getCollection } from 'astro:content';
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import { systemModules } from '../config/system-modules.mjs';
import { getDocHref, getEntityIconUrl, getModuleIconUrl } from '../utils/content';

const documents = (await getCollection('docs'))
  .filter((entry) => !entry.data.sidebar.hidden)
  .map((entry) => ({
    entry,
    iconUrl: getEntityIconUrl(entry.data.entity, entry.data.icon),
  }))
  .filter((document) => Boolean(document.iconUrl));
const entrySelectors = documents.map(
  ({ entry }) => `.sidebar-content a[href='${getDocHref(entry.id)}']`,
);
const entryAssignments = documents
  .map(
    ({ entry, iconUrl }) =>
      `.sidebar-content a[href='${getDocHref(entry.id)}'] { --sidebar-entry-icon: url('${iconUrl}'); }`,
  )
  .join('\n');

// O catálogo também fornece ícones para categorias ainda sem documentos.
const moduleIcons = systemModules.map((module) => ({
  label: module.label,
  iconUrl: getModuleIconUrl(module.slug),
}));

const sidebarIconStyles = `
${entryAssignments}
${entrySelectors.join(',\n')} {
  display: flex;
  align-items: center;
  gap: 0.55rem;
}
${entrySelectors.map((selector) => `${selector}::before`).join(',\n')} {
  content: '';
  flex: 0 0 auto;
  width: 1.1rem;
  height: 1.1rem;
  background-color: currentColor;
  mask: var(--sidebar-entry-icon) center / contain no-repeat;
  -webkit-mask: var(--sidebar-entry-icon) center / contain no-repeat;
}
.sidebar-content .sidebar-module-label {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}
.sidebar-content .sidebar-module-label::before {
  content: '';
  flex: 0 0 auto;
  width: 1.05rem;
  height: 1.05rem;
  background-color: var(--sl-color-text-accent);
  mask: var(--sidebar-module-icon) center / contain no-repeat;
  -webkit-mask: var(--sidebar-module-icon) center / contain no-repeat;
}`;
---

<DefaultSidebar />
<style is:inline set:html={sidebarIconStyles}></style>
<script type="application/json" id="sidebar-module-icons" set:html={JSON.stringify(moduleIcons)} />

<script>
  const initializeSidebar = () => {
    const moduleIcons: { label: string; iconUrl: string }[] = JSON.parse(
      document.getElementById('sidebar-module-icons')?.textContent ?? '[]',
    );
    const iconsByLabel = new Map(moduleIcons.map((module) => [module.label, module.iconUrl]));
    for (const content of document.querySelectorAll<HTMLElement>('.sidebar-content')) {
      for (const label of content.querySelectorAll<HTMLElement>('details > summary .group-label > .large')) {
        const iconUrl = iconsByLabel.get(label.textContent?.trim() ?? '');
        if (!iconUrl) continue;
        label.classList.add('sidebar-module-label');
        label.style.setProperty('--sidebar-module-icon', `url('${iconUrl}')`);
      }

      // Move the existing preferences so visual and keyboard order both start with the theme.
      const preferences = content.querySelector('.mobile-preferences')?.parentElement;
      if (preferences?.parentElement === content) content.prepend(preferences);

      // Keep only the current page's ancestors open, overriding restored desktop state.
      for (const group of content.querySelectorAll<HTMLDetailsElement>('details')) {
        group.open = Boolean(group.querySelector('a[aria-current="page"]'));
      }

      if (!content.dataset.mobileNavigationReady) {
        content.dataset.mobileNavigationReady = 'true';
        content.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (link && matchMedia('(max-width: 49.99rem)').matches) {
            const sidebar = content.closest<HTMLElement>('#starlight__sidebar');
            if (sidebar?.matches(':popover-open')) sidebar.hidePopover();
          }
        });
      }
    }
  };

  initializeSidebar();
  document.addEventListener('astro:page-load', initializeSidebar);
</script>
