---
import StarlightMarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
import RequirementUserStory from './RequirementUserStory.astro';
import StoryReferences from './StoryReferences.astro';
---

<StarlightMarkdownContent>
  <RequirementUserStory />
  <slot />
  <StoryReferences />
</StarlightMarkdownContent>

<script>
  import { withBase } from '../utils/content';
  let requirementGroupSequence = 0;
  let requirementComponentSequence = 0;

  const wrapTable = (table: HTMLTableElement) => {
    if (table.parentElement?.classList.contains('requirement-table-scroll')) return;
    const container = document.createElement('div');
    container.className = 'requirement-table-scroll';
    if (table.classList.contains('history-source')) container.classList.add('history-source');
    table.before(container);
    container.append(table);
  };

  const normalizeHeader = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim()
      .toLowerCase();

  const getHeading = (element: Element) =>
    element.matches('h3, h4, h5, h6')
      ? (element as HTMLHeadingElement)
      : element.querySelector<HTMLHeadingElement>(':scope > h3, :scope > h4, :scope > h5, :scope > h6');

  const getHeadingLevel = (heading: HTMLHeadingElement) => Number(heading.tagName.slice(1));

  const getTableHeaders = (table: HTMLTableElement) =>
    Array.from(table.tHead?.rows[0]?.cells ?? [], (cell) => {
      const header = normalizeHeader(cell.textContent ?? '');
      return header.startsWith('obrigatorio') ? 'obrigatorio' : header;
    });

  const normalizeRequirementTableHeaders = (table: HTMLTableElement) => {
    for (const cell of Array.from(table.tHead?.rows[0]?.cells ?? [])) {
      if (normalizeHeader(cell.textContent ?? '').startsWith('obrigatorio')) {
        cell.textContent = 'Obrigatório';
      }
    }
  };

  // Reconhece tabelas pelo cabeçalho, sem exigir uma classe escrita manualmente no MDX.
  const isFieldTable = (table: HTMLTableElement) => {
    const headers = getTableHeaders(table);

    return (
      headers.includes('campo') &&
      headers.includes('tipo') &&
      headers.some((header) => header.startsWith('obrigatorio')) &&
      headers.includes('validacoes') &&
      headers.includes('exemplo') &&
      headers.includes('valor padrao')
    );
  };

  const getCardinality = (title: string) => {
    const match = title.toLowerCase().match(/\((zero ou mais|um ou mais|uma ou mais|zero ou um|zero ou uma)\)\s*$/);

    return match?.[1];
  };

  const getRailOffset = (depth: number) => `${(depth - 1) * 0.75}rem`;

  const getGroupBackground = (depths: number[]) => {
    const depth = Math.min(depths.at(-1) ?? 1, 4);
    const contentOffset = `calc(${getRailOffset(depth)} + var(--requirement-rail-width))`;

    return `linear-gradient(to right, var(--sl-color-black) 0 ${contentOffset}, var(--requirement-group-bg-${depth}) ${contentOffset} 100%)`;
  };

  const addNestingRails = (container: HTMLElement, depths: number[]) => {
    for (const depth of depths) {
      const rail = document.createElement('span');
      rail.className = 'requirement-nesting-rail';
      rail.dataset.depth = String(depth);
      rail.style.setProperty('--requirement-rail-offset', getRailOffset(depth));
      rail.setAttribute('aria-hidden', 'true');
      container.append(rail);
    }
  };

  const createGroupRow = (headingContainer: Element, columnCount: number, groupPath: number[]) => {
    const heading = getHeading(headingContainer);
    if (!heading) return;

    const depth = getHeadingLevel(heading) - 2;
    const row = document.createElement('tr');
    const cell = document.createElement('th');
    const content = document.createElement('div');
    const groupLabel = document.createElement('div');
    const toggle = document.createElement('button');
    const chips = document.createElement('div');
    const cardinality = getCardinality(heading.textContent ?? '');
    const groupId = `requirement-group-${++requirementGroupSequence}`;

    row.className = 'requirement-group-row';
    row.dataset.depth = String(depth);
    row.style.setProperty('--requirement-depth', String(depth));
    row.style.setProperty('--requirement-active-rail-offset', getRailOffset(depth));
    cell.className = 'requirement-group-cell';
    cell.colSpan = columnCount;
    cell.scope = 'rowgroup';
    cell.style.setProperty('--requirement-group-background', getGroupBackground(groupPath));
    content.className = 'requirement-group-row__content';
    groupLabel.className = 'requirement-group-label';
    toggle.className = 'requirement-group-toggle';
    toggle.type = 'button';
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', `Recolher seção ${heading.textContent?.trim() ?? ''}`);
      toggle.addEventListener('click', () => {
      const collapsed = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.setAttribute(
        'aria-label',
        `${collapsed ? 'Expandir' : 'Recolher'} seção ${heading.textContent?.trim() ?? ''}`,
      );

      let sibling = row.nextElementSibling as HTMLTableRowElement | null;
      while (sibling) {
        if (
          (sibling.classList.contains('requirement-group-row') ||
            sibling.classList.contains('requirement-group-divider')) &&
          Number(sibling.dataset.depth) <= depth
        ) {
          break;
        }

        const collapsedBy = new Set((sibling.dataset.collapsedBy ?? '').split(' ').filter(Boolean));
        if (collapsed) collapsedBy.add(groupId);
        else collapsedBy.delete(groupId);
        sibling.dataset.collapsedBy = Array.from(collapsedBy).join(' ');
        sibling.hidden = collapsedBy.size > 0;
        sibling = sibling.nextElementSibling as HTMLTableRowElement | null;
      }
      scheduleComponentFrames();
    });
    chips.className = 'requirement-group-chips';

    headingContainer.classList.add('requirement-group-row__heading');
    groupLabel.append(toggle, headingContainer);
    content.append(groupLabel, chips);

    if (cardinality) {
      const badge = document.createElement('span');
      badge.className = 'requirement-cardinality';
      badge.textContent = cardinality;
      badge.setAttribute('aria-label', `Cardinalidade ${cardinality}`);
      chips.append(badge);
    }

    addNestingRails(cell, groupPath);
    cell.append(content);
    row.append(cell);

    return { row, cell, chips, groupLabel, headingContainer, depth };
  };

  const createGroupDivider = (columnCount: number, depth: number, ancestorDepths: number[]) => {
    const row = document.createElement('tr');
    const cell = document.createElement('td');
    row.className = 'requirement-group-divider';
    row.dataset.depth = String(depth);
    row.setAttribute('aria-hidden', 'true');
    cell.className = 'requirement-group-divider-cell';
    cell.colSpan = columnCount;
    addNestingRails(cell, ancestorDepths);
    row.append(cell);
    return row;
  };

  // Agrupa tabelas de campos compatíveis em uma única tabela hierárquica interativa.
  const enhanceSection = (nodes: Element[], tables: HTMLTableElement[]) => {
    const signatures = new Set(tables.map((table) => getTableHeaders(table).join('|')));

    // Tabelas com grades diferentes permanecem intactas para não alterar sua semântica.
    if (signatures.size !== 1) return;

    const target = tables[0];
    const targetBody = target.tBodies[0];
    const columnCount = getTableHeaders(target).length;
    if (!targetBody || !columnCount) return;

    const rowsByTable = new Map(
      tables.map((table) => [table, Array.from(table.tBodies[0]?.rows ?? [])] as const),
    );
    const fragment = document.createDocumentFragment();
    let activeGroup: ReturnType<typeof createGroupRow>;
    let activeDepth = 1;
    let activeGroupHasFields = false;
    let activeGroupIsComponent = false;
    let activeComponentFrameId: string | undefined;
    let fieldRowIndex = 0;
    const groupDepths: number[] = [];

    for (const node of nodes) {
      const heading = getHeading(node);

      if (heading) {
        const nextDepth = getHeadingLevel(heading) - 2;
        if (groupDepths.length > 0) {
          fragment.append(
            createGroupDivider(columnCount, nextDepth, groupDepths.filter((depth) => depth < nextDepth)),
          );
        }
        while (groupDepths.at(-1) !== undefined && groupDepths.at(-1)! >= nextDepth) {
          groupDepths.pop();
        }
        groupDepths.push(nextDepth);

        activeGroup = createGroupRow(node, columnCount, groupDepths);
        activeDepth = activeGroup?.depth ?? 1;
        activeGroupHasFields = false;
        activeGroupIsComponent = false;
        activeComponentFrameId = undefined;
        if (activeGroup) {
          fragment.append(activeGroup.row);
        }
        continue;
      }

      if (node.matches('p') && activeGroup && !activeGroupHasFields) {
        const isCondition = /^(disponível|visível|exibido|obrigatório)\s+se\b/i.test(
          node.textContent?.trim() ?? '',
        );
        node.classList.add(isCondition ? 'requirement-group-condition' : 'requirement-group-note');
        activeGroup.chips.append(node);
        continue;
      }

      if (!(node instanceof HTMLTableElement) || !rowsByTable.has(node)) continue;

      const isComponentTable = node.classList.contains('component-field-table');
      const componentName = node.dataset.componentName ?? 'Componente';
      const componentId = node.dataset.componentId;
      if (isComponentTable && activeGroup && !activeGroupIsComponent) {
        activeGroupIsComponent = true;
        activeComponentFrameId = `requirement-component-frame-${++requirementComponentSequence}`;
        activeGroup.row.classList.add('requirement-component-group');
        activeGroup.row.dataset.componentFrame = activeComponentFrameId;
        const badge = document.createElement('a');
        badge.className = 'requirement-component-badge';
        badge.textContent = `Componente · ${componentName}`;
        badge.href = withBase(`/sobre/componentes/#${componentId ?? ''}`);
        activeGroup.groupLabel.insertBefore(badge, activeGroup.headingContainer);
      }

      for (const row of rowsByTable.get(node) ?? []) {
        row.classList.add('requirement-field-row');
        row.dataset.stripe = fieldRowIndex++ % 2 === 0 ? 'odd' : 'even';
        row.dataset.depth = String(activeDepth);
        row.style.setProperty('--requirement-depth', String(activeDepth));
        row.style.setProperty('--requirement-active-rail-offset', getRailOffset(activeDepth));

        if (activeGroupIsComponent && activeComponentFrameId) {
          row.classList.add('requirement-component-field-row');
          row.dataset.componentFrame = activeComponentFrameId;
        }

        if (row.cells[0]) addNestingRails(row.cells[0], groupDepths);
        fragment.append(row);
      }

      activeGroupHasFields = true;
      if (node !== target) node.remove();
    }

    targetBody.replaceChildren(fragment);
    target.classList.add('requirement-table--hierarchical');
    target.dataset.requirementColumns = String(columnCount);

    wrapTable(target);
  };

  // Desenha contornos posicionados sobre as linhas pertencentes a cada componente.
  const renderComponentFrames = () => {
    document.querySelectorAll('.requirement-component-frame').forEach((frame) => frame.remove());

    for (const container of document.querySelectorAll<HTMLElement>('.requirement-table-scroll')) {
      const table = container.querySelector<HTMLTableElement>('.requirement-table--hierarchical');
      if (!table) continue;

      const componentRows = new Map<string, HTMLTableRowElement[]>();
      for (const row of table.querySelectorAll<HTMLTableRowElement>('tr[data-component-frame]')) {
        const id = row.dataset.componentFrame;
        if (!id) continue;
        const rows = componentRows.get(id) ?? [];
        rows.push(row);
        componentRows.set(id, rows);
      }

      const tableRect = table.getBoundingClientRect();
      const containerRect = container.getBoundingClientRect();
      const finalTableRow = table.tBodies[0]?.rows.item(table.tBodies[0].rows.length - 1);
      let componentAtTableEnd = false;
      for (const [id, rows] of componentRows) {
        const headingRow = rows.find((row) => row.classList.contains('requirement-component-group'));
        if (!headingRow || rows.every((row) => row.hidden)) continue;

        const isCollapsed = headingRow.querySelector('.requirement-group-toggle')?.getAttribute('aria-expanded') === 'false';
        const firstRow = headingRow;
        const lastRow = isCollapsed ? headingRow : rows.at(-1);
        if (!lastRow) continue;

        const firstRect = firstRow.getBoundingClientRect();
        const lastRect = lastRow.getBoundingClientRect();
        const depth = Number.parseInt(headingRow.dataset.depth ?? '1', 10);
        const railWidth = getComputedStyle(table).getPropertyValue('--requirement-rail-width').trim() || '0.22rem';
        const rootFontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        const toPixels = (value: string) => {
          const length = Number.parseFloat(value) || 0;
          return value.trim().endsWith('rem') ? length * rootFontSize : length;
        };
        const inset = toPixels(getRailOffset(depth)) + toPixels(railWidth);
        const frameLeft = tableRect.left + inset;
        const frame = document.createElement('div');
        frame.className = 'requirement-component-frame';
        frame.dataset.componentFrame = id;
        frame.setAttribute('aria-hidden', 'true');
        // Position inside the scroll container so its overflow clips the whole outline.
        frame.style.left = `${frameLeft - containerRect.left + container.scrollLeft}px`;
        frame.style.top = `${firstRect.top - containerRect.top + container.scrollTop}px`;
        frame.style.width = `${Math.max(0, tableRect.right - frameLeft)}px`;
        frame.style.height = `${lastRect.bottom - firstRect.top}px`;
        frame.style.setProperty(
          '--requirement-component-frame-accent',
          getComputedStyle(headingRow).getPropertyValue('--requirement-group-current-accent').trim(),
        );
        container.append(frame);
        if (rows.at(-1) === finalTableRow) componentAtTableEnd = true;
      }
      container.classList.toggle('requirement-table-scroll--component-at-end', componentAtTableEnd);
    }
  };

  let componentFrameRenderScheduled = false;
  const scheduleComponentFrames = () => {
    if (componentFrameRenderScheduled) return;
    componentFrameRenderScheduled = true;
    requestAnimationFrame(() => {
      componentFrameRenderScheduled = false;
      renderComponentFrames();
    });
  };

  // Converte as tabelas e subtítulos do Markdown em grupos navegáveis no navegador.
  const enhanceRequirementTables = () => {
    for (const content of document.querySelectorAll<HTMLElement>('.sl-markdown-content')) {
      const children = Array.from(content.children);

      for (let index = 0; index < children.length; index += 1) {
        const heading = children[index];
        if (!(heading instanceof HTMLHeadingElement) || heading.tagName !== 'H2') continue;

        let sectionEnd = index + 1;
        while (sectionEnd < children.length) {
          const nextHeading = children[sectionEnd].matches('h1, h2');
          if (nextHeading) break;
          sectionEnd += 1;
        }

        const sectionNodes = children.slice(index + 1, sectionEnd);
        const hasFieldTable = sectionNodes.some((node) => {
          const tables = node instanceof HTMLTableElement
            ? [node]
            : Array.from(node.querySelectorAll<HTMLTableElement>('table'));
          return tables.some(isFieldTable);
        });

        if (hasFieldTable) heading.classList.add('requirement-form-heading');
      }

      for (let index = 0; index < children.length; index += 1) {
        const sectionHeading = getHeading(children[index]);
        if (!sectionHeading || getHeadingLevel(sectionHeading) !== 3) continue;

        const sectionNodes: Element[] = [];
        const tables: HTMLTableElement[] = [];
        let tableSignature: string | undefined;
        let sectionIndex = index;

        // Seções irmãs com a mesma estrutura compartilham a tabela, mantendo
        // cada título como um grupo independente no mesmo nível hierárquico.
        while (sectionIndex < children.length) {
          const heading = getHeading(children[sectionIndex]);
          if (!heading || getHeadingLevel(heading) !== 3) break;

          let sectionEnd = sectionIndex + 1;
          while (sectionEnd < children.length) {
            const nextHeading = getHeading(children[sectionEnd]);
            if (nextHeading && getHeadingLevel(nextHeading) <= 3) break;
            sectionEnd += 1;
          }

          const nextNodes = children.slice(sectionIndex, sectionEnd);
          const nextTables = nextNodes.filter(
            (node): node is HTMLTableElement => node instanceof HTMLTableElement && isFieldTable(node),
          );
          nextTables.forEach(normalizeRequirementTableHeaders);
          const nextSignatures = new Set(nextTables.map((table) => getTableHeaders(table).join('|')));
          const nextSignature = nextSignatures.size === 1 ? [...nextSignatures][0] : undefined;

          if (!nextSignature || (tableSignature && nextSignature !== tableSignature)) break;

          tableSignature = nextSignature;
          sectionNodes.push(...nextNodes);
          tables.push(...nextTables);
          sectionIndex = sectionEnd;
        }

        if (tables.length > 0 && !tables[0].classList.contains('requirement-table--hierarchical')) {
          enhanceSection(sectionNodes, tables);
        }

        index = Math.max(index, sectionIndex - 1);
      }
    }

    document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table').forEach(wrapTable);

    if (window.location.hash) {
      const anchor = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
      requestAnimationFrame(() => anchor?.scrollIntoView({ block: 'start' }));
    }
  };

  enhanceRequirementTables();
  requestAnimationFrame(renderComponentFrames);
  window.addEventListener('resize', scheduleComponentFrames);
  document.addEventListener('astro:page-load', () => {
    enhanceRequirementTables();
    scheduleComponentFrames();
  });
  document.addEventListener('scroll', scheduleComponentFrames, true);
</script>
